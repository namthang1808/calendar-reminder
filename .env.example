# Supabase — from your project's Settings > API page.
# NEXT_PUBLIC_ vars are inlined into the browser bundle; never put a secret there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (see Phase 4 setup). Bot username is public by nature
# (searchable in Telegram) -- safe as a NEXT_PUBLIC_ var, unlike the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Shared secret checked by app/api/cron/send-reminders — must match the
# value configured in the Supabase pg_cron job (see Phase 5 setup).
CRON_SHARED_SECRET=
